{
  "plugins": [
    {
      "options": {},
      "plugin": "@nx/js"
    },
    {
      "options": {},
      "plugin": "@nx-devkit/typescript"
    },
    {
      "options": {},
      "plugin": "@nx-devkit/prepare-for-release"
    },
    {
      "options": {},
      "plugin": "@nx-devkit/sverka"
    }
  ],
  "release": {
    "projects": ["pi-anyrouter-dev"],
    "version": {
      "conventionalCommits": true,
      "preVersionCommand": "npx nx run-many -t build",
      "git": {
        "commit": true,
        "tag": true
      }
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github"
      }
    }
  }
}

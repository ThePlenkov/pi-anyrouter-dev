{
  "plugins": [
    {
      "options": {},
      "plugin": "@nx/js"
    },
    {
      "options": {},
      "plugin": "@nx-devkit/typescript"
    },
    {
      "options": {},
      "plugin": "@nx-devkit/prepare-for-release"
    },
    {
      "options": {},
      "plugin": "@nx-devkit/sverka"
    }
  ],
  "release": {
    "projects": ["pi-anyrouter-dev", "pi-aihubmix-com", "@pi-extensions/shared"],
    "version": {
      "conventionalCommits": true,
      "preVersionCommand": "npx nx run-many -t build",
      "git": {
        "commit": true,
        "tag": true
      }
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github"
      }
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default", "!{projectRoot}/**/*.spec.ts"],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "typecheck": {
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true
    }
  }
}
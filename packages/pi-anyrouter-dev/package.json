{
  "name": "pi-anyrouter-dev",
  "version": "0.1.5",
  "description": "AnyRouter (anyrouter.dev) provider for the pi coding agent - a thin layer over pi's built-in OpenAI-compatible client with a dynamically fetched model catalog",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "types": "./dist/index.d.mts",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "anyrouter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThePlenkov/pi-anyrouter-dev.git",
    "directory": "packages/pi-anyrouter-dev"
  },
  "bugs": {
    "url": "https://github.com/ThePlenkov/pi-anyrouter-dev/issues"
  },
  "homepage": "https://github.com/ThePlenkov/pi-anyrouter-dev/tree/main/packages/pi-anyrouter-dev#readme",
  "pi": {
    "extensions": [
      "./dist/index.mjs"
    ]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "prepack": "bash scripts/prepack.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  }
}

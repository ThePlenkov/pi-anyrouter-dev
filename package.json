{
  "name": "pi-anyrouter-dev",
  "version": "0.1.2",
  "description": "AnyRouter (anyrouter.dev) provider for the pi coding agent - a thin layer over pi's built-in OpenAI-compatible client with a dynamically fetched model catalog",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "types": "./dist/index.d.mts",
  "files": [
    "LICENSE",
    "README.md",
    "src",
    "dist"
  ],
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "anyrouter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThePlenkov/pi-anyrouter-dev.git"
  },
  "bugs": {
    "url": "https://github.com/ThePlenkov/pi-anyrouter-dev/issues"
  },
  "homepage": "https://github.com/ThePlenkov/pi-anyrouter-dev#readme",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "prepack": "bash scripts/prepack.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@nx-devkit/prepare-for-release": "^0.1.23",
    "@nx-devkit/sverka": "^0.0.1",
    "@nx-devkit/typescript": "^0.2.19",
    "@nx/devkit": "^24.0.0",
    "@nx/js": "^24.0.0",
    "@types/node": "^22.20.5",
    "@typescript/native-preview": "^7.0.0-dev.20260621.1",
    "nx": "^24.0.0",
    "publint": "^0.3.25",
    "sverka": "^0.2.46",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  }
}

{
  "name": "pi-anyrouter-dev",
  "version": "0.1.0",
  "description": "AnyRouter (anyrouter.dev) provider for the pi coding agent - a thin layer over pi's built-in OpenAI-compatible client with a dynamically fetched model catalog",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "LICENSE",
    "README.md",
    "src",
    "index.ts"
  ],
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "anyrouter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThePlenkov/pi-anyrouter-dev.git"
  },
  "bugs": {
    "url": "https://github.com/ThePlenkov/pi-anyrouter-dev/issues"
  },
  "homepage": "https://github.com/ThePlenkov/pi-anyrouter-dev#readme",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.2"
  }
}

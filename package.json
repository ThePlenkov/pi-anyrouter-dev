{
  "name": "pi-anyrouter-dev-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build --filter=pi-anyrouter-dev",

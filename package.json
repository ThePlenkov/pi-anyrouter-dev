    "@nx/devkit": "^24.0.0",
    "@nx/js": "^24.0.0",
    "nx": "^24.0.0",
    "publint": "^0.3.25",
    "sverka": "^0.2.46",
    "tsdown": "^0.23.1"
  }
}
